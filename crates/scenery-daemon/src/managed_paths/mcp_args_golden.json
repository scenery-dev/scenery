{
  "_comment": "Golden vectors for MCP argument redaction. Shared with scenery-backend (sanitize_discovery_args): both sides must produce exactly `expected`. `command` may carry its own arguments; the runner splits it first. Vectors with \"added_by\": \"backend\" are leak cases the runner (as of b25e6f0) does not redact yet; `expected_command` is the executable basename the backend derives (the runner should send the same). Vectors with \"added_by\": \"runner\" came from the runner fixture and were not in the backend one; \"short flag =value\" there originally expected -p=pw -> <redacted> and was updated to the backend rule -p=<redacted>. Vectors with \"added_by\": \"review\" came from the AUTO-MANAGE P2 validation follow-up (benign flag values, home-path masking); both sides pass them. \"field_vectors\" cover the identifying names a device reports (server_key, client_name, env_key): a credential-shaped token inside one is replaced by <redacted> wherever it starts. Vectors with \"added_by\": \"review2\" are the second validation round: a token after a separator in a version, tag or path, lexical path normalisation before home masking, and a token-shaped executable name (expected_command null: no usable command, so no args).",
  "vectors": [
    {"name": "npx registry with userinfo", "command": "npx", "args": ["--registry", "https://user:tok@host", "pkg"], "expected": ["--registry", "<redacted>", "pkg"]},
    {"name": "docker -e TOKEN=x", "command": "docker", "args": ["run", "-e", "TOKEN=x", "image"], "expected": ["run", "-e", "<redacted>", "<redacted>"]},
    {"name": "npx pinned public package", "command": "npx", "args": ["-y", "@modelcontextprotocol/server-everything@1.2.3"], "expected": ["-y", "@modelcontextprotocol/server-everything@1.2.3"]},
    {"name": "opaque --token value", "command": "node", "args": ["srv.js", "--token", "opaque"], "expected": ["<redacted>", "--token", "<redacted>"]},
    {"name": "Authorization header as one arg", "command": "node", "args": ["Authorization: Bearer x"], "expected": ["<redacted>"]},
    {"name": "uvx --from git url with token", "command": "uvx", "args": ["--from", "git+https://tok@host/repo.git", "pkg"], "expected": ["--from", "git+https://host", "pkg"]},
    {"name": "mysql -pSECRET", "command": "mysql", "args": ["-pSECRET"], "expected": ["<redacted>"]},
    {"name": "sshpass -p pw", "command": "sshpass", "args": ["-p", "pw", "ssh", "host"], "expected": ["-p", "<redacted>", "<redacted>", "<redacted>"]},
    {"name": "sh -c with env assignment", "command": "sh", "args": ["-c", "TOKEN=x node srv"], "expected": ["-c", "<redacted>"]},
    {"name": "everything after -c is redacted", "command": "bash", "args": ["-c", "echo", "hi", "--flag"], "expected": ["-c", "<redacted>", "<redacted>", "<redacted>"]},
    {"name": "command string carrying its own args", "command": "npx -y pkg --api-key sk-ant-abcdefghijklmnopqrstuvwx", "args": [], "expected": ["-y", "pkg", "--api-key", "<redacted>"]},
    {"name": "path keeps tilde, KEY=VALUE redacted", "command": "node", "args": ["~/srv/server.js", "API_KEY=abc"], "expected": ["~/srv/server.js", "API_KEY=<redacted>"]},
    {"name": "benign flags keep safe values", "command": "node", "args": ["--port", "3000", "--transport", "stdio", "--stdio"], "expected": ["--port", "3000", "--transport", "stdio", "--stdio"]},
    {"name": "benign --flag=word", "command": "node", "args": ["--port=8080", "--foo=bar"], "expected": ["--port=8080", "--foo=<redacted>"]},
    {"name": "credential-shaped bare arg", "command": "node", "args": ["ghp_abcdefghijklmnopqrstuvwxyz0123456789"], "expected": ["<redacted>"]},
    {"name": "high-entropy bare arg", "command": "node", "args": ["a8Fk29xLq0ZpW3mN7vB1cD5eR"], "expected": ["<redacted>"]},
    {"name": "docker switches and image", "command": "docker", "args": ["run", "-i", "--rm", "ghcr.io/org/img:1.4"], "expected": ["run", "-i", "--rm", "ghcr.io/org/img:1.4"]},
    {"name": "bare url keeps origin only", "command": "node", "args": ["https://user:pw@host:8443/path?q=1"], "expected": ["https://host:8443"]},
    {"name": "unknown positional", "command": "node", "args": ["some-private-thing"], "expected": ["<redacted>"]},
    {"name": "command string with leading env assignment", "command": "TOKEN=sk-live-abc123 node srv.js", "args": [], "expected": ["TOKEN=<redacted>", "<redacted>"], "expected_command": "node", "added_by": "backend"},
    {"name": "Codex TOML command, env assignment then launcher", "command": "API_KEY=hunter2 npx -y @acme/mcp@1.0.0", "args": ["--stdio"], "expected": ["API_KEY=<redacted>", "-y", "@acme/mcp@1.0.0", "--stdio"], "expected_command": "npx", "added_by": "backend"},
    {"name": "colon-attached flag value", "command": "node", "args": ["--token:abc123", "x"], "expected": ["<redacted>", "<redacted>"], "added_by": "backend"},
    {"name": "colon-attached flag with equals", "command": "node", "args": ["--api-key:abc=xyz"], "expected": ["<redacted>"], "added_by": "backend"},
    {"name": "secret-shaped flag name", "command": "node", "args": ["--ghp_abcdefghijklmnopqrstuvwxyz0123456789"], "expected": ["<redacted>"], "added_by": "backend"},
    {"name": "second npm-shaped positional is not a package", "command": "npx", "args": ["-y", "pkg", "hunter2"], "expected": ["-y", "pkg", "<redacted>"], "added_by": "backend"},
    {"name": "docker image then trailing word", "command": "docker", "args": ["run", "-i", "--rm", "ghcr.io/org/img:1.4", "hunter2"], "expected": ["run", "-i", "--rm", "ghcr.io/org/img:1.4", "<redacted>"], "added_by": "backend"},
    {"name": "uvx --from value does not use up the package slot", "command": "uvx", "args": ["--from", "mcp-server-foo==1.0", "mcp-server-foo"], "expected": ["--from", "mcp-server-foo==1.0", "mcp-server-foo"]},
    {"name": "sshpass with command path", "command": "/usr/bin/sshpass", "args": ["-p", "pw", "ssh", "host"], "expected": ["-p", "<redacted>", "<redacted>", "<redacted>"], "expected_command": "sshpass", "added_by": "backend"},
    {"name": "Codex TOML sh -c with quoted script", "command": "sh -c 'TOKEN=x node srv'", "args": [], "expected": ["-c", "<redacted>", "<redacted>", "<redacted>"], "expected_command": "sh", "added_by": "backend"},
    {"name": "env launcher carrying assignments", "command": "env", "args": ["TOKEN=x", "node", "srv.js"], "expected": ["TOKEN=<redacted>", "<redacted>", "<redacted>"]},
    {"name": "mysql attached password with host", "command": "mysql", "args": ["-h", "localhost", "-pSECRET", "-uroot"], "expected": ["-h", "<redacted>", "<redacted>", "<redacted>"]},
    {"name": "attached value containing =", "command": "mysql", "args": ["-pMy=Pass", "-pc2VjcmV0cGFzcw=="], "expected": ["<redacted>", "<redacted>"], "added_by": "backend"},
    {"name": "short flag with equals keeps only its name", "command": "node", "args": ["-p=secret", "-x=1"], "expected": ["-p=<redacted>", "-x=<redacted>"], "added_by": "backend"},
    {"name": "mysql -p with base64 password ending in ==", "command": "mysql", "args": ["-pc2VjcmV0cGFzcw=="], "expected": ["<redacted>"], "added_by": "runner"},
    {"name": "mysql -p attached value containing =", "command": "mysql", "args": ["-pMy=Pass"], "expected": ["<redacted>"], "added_by": "runner"},
    {"name": "short flag =value", "command": "node", "args": ["-p=pw", "--key=abc"], "expected": ["-p=<redacted>", "--key=<redacted>"], "added_by": "runner"},
    {"name": "docker combined booleans stay", "command": "docker", "args": ["run", "-it", "--rm", "ghcr.io/org/img:1.4"], "expected": ["run", "-it", "--rm", "ghcr.io/org/img:1.4"], "added_by": "runner"},
    {"name": "port value that is a word", "command": "npx", "args": ["--port=mypassword", "-y", "pkg"], "expected": ["--port=<redacted>", "-y", "pkg"], "added_by": "review"},
    {"name": "port as separate word", "command": "npx", "args": ["--port", "mypassword", "-y", "pkg"], "expected": ["--port", "<redacted>", "-y", "pkg"], "added_by": "review"},
    {"name": "transport value that is not a known word", "command": "npx", "args": ["--transport", "s3cretpw", "pkg"], "expected": ["--transport", "<redacted>", "pkg"], "added_by": "review"},
    {"name": "transport attached value that is not a known word", "command": "npx", "args": ["--transport=s3cretpw", "pkg"], "expected": ["--transport=<redacted>", "pkg"], "added_by": "review"},
    {"name": "transport known words stay", "command": "node", "args": ["--transport", "streamable-http", "--transport=sse", "--transport", "http"], "expected": ["--transport", "streamable-http", "--transport=sse", "--transport", "http"], "added_by": "review"},
    {"name": "port that is not a number or too long", "command": "node", "args": ["--port", "80a", "--port=123456"], "expected": ["--port", "<redacted>", "--port=<redacted>"], "added_by": "review"},
    {"name": "yes, short yes and stdio take no value", "command": "npx", "args": ["--yes=hunter2", "-y=hunter2", "--stdio=hunter2", "pkg"], "expected": ["--yes=<redacted>", "-y=<redacted>", "--stdio=<redacted>", "pkg"], "added_by": "review"},
    {"name": "yes and stdio followed by a package", "command": "npx", "args": ["--yes", "--stdio", "pkg"], "expected": ["--yes", "--stdio", "pkg"], "added_by": "review"},
    {"name": "double slash home path", "command": "node", "args": ["//Users/adam/x"], "expected": ["~/x"], "added_by": "review"},
    {"name": "repeated slashes inside a home path", "command": "node", "args": ["/home/adam//proj///srv.js"], "expected": ["~/proj/srv.js"], "added_by": "review"},
    {"name": "external volume home", "command": "node", "args": ["/Volumes/Data/Users/adam/srv.js"], "expected": ["~/srv.js"], "added_by": "review"},
    {"name": "external volume home dir on linux layout", "command": "node", "args": ["/Volumes/Data/home/adam/srv.js"], "expected": ["~/srv.js"], "added_by": "review"},
    {"name": "volume named home", "command": "node", "args": ["/Volumes/home/adam/x"], "expected": ["~/x"], "added_by": "review"},
    {"name": "Shared is not a home", "command": "node", "args": ["/Users/Shared/x"], "expected": ["/Users/Shared/x"], "added_by": "review"},
    {"name": "Shared with repeated slashes is not a home", "command": "node", "args": ["//Users//Shared/x"], "expected": ["/Users/Shared/x"], "added_by": "review"},
    {"name": "system dir under /home is not a home", "command": "node", "args": ["/home/linuxbrew/.linuxbrew/bin/node"], "expected": ["/home/linuxbrew/.linuxbrew/bin/node"], "added_by": "review"},
    {"name": "token after a separator in a pinned npm version", "command": "npx", "args": ["pkg@1.0.0-ghp_a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R8"], "expected": ["<redacted>"], "added_by": "review2"},
    {"name": "Anthropic key after a separator in an npm tag", "command": "npx", "args": ["pkg@latest-sk-ant-abcdefghijklmnopqrstuvwx"], "expected": ["<redacted>"], "added_by": "review2"},
    {"name": "token in a uvx --from package", "command": "uvx", "args": ["--from", "pkg-ghp_a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R8"], "expected": ["--from", "<redacted>"], "added_by": "review2"},
    {"name": "token in a docker image tag", "command": "docker", "args": ["run", "img:v1-ghp_a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R8"], "expected": ["run", "<redacted>"], "added_by": "review2"},
    {"name": "token at the end of a path segment", "command": "node", "args": ["/tmp/x-ghp_a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R8"], "expected": ["<redacted>"], "added_by": "review2"},
    {"name": "token after a dot in a relative path", "command": "node", "args": ["./cfg.ghp_a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R8"], "expected": ["<redacted>"], "added_by": "review2"},
    {"name": "var/home is a home", "command": "node", "args": ["/var/home/adam/x"], "expected": ["~/x"], "added_by": "review2"},
    {"name": "dot segment before a home", "command": "node", "args": ["/./Users/adam/x"], "expected": ["~/x"], "added_by": "review2"},
    {"name": "dot-dot back into a home", "command": "node", "args": ["/Users/../Users/adam/x"], "expected": ["~/x"], "added_by": "review2"},
    {"name": "dot-dot out of a system home into a user home", "command": "node", "args": ["/home/linuxbrew/../adam/x"], "expected": ["~/x"], "added_by": "review2"},
    {"name": "dot-dot in a plain path is resolved lexically", "command": "node", "args": ["/tmp/a/../b"], "expected": ["/tmp/b"], "added_by": "review2"},
    {"name": "trailing slash on a home path", "command": "node", "args": ["/home/adam/"], "expected": ["~/"], "added_by": "review2"},
    {"name": "token-shaped executable basename drops the command", "command": "/Users/a/bin/ghp_a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R8", "args": ["--port", "3000"], "expected": [], "expected_command": null, "added_by": "review2"}
  ],
  "field_vectors": [
    {"name": "server key with an embedded token", "field": "server_key", "input": "gh-ghp_abcdefghijklmnopqrstuvwxyz0123456789", "expected": "gh-<redacted>"},
    {"name": "plain server key", "field": "server_key", "input": "filesystem-mcp", "expected": "filesystem-mcp"},
