    {"name": "discovery slug with a token", "field": "slug", "input": "Cursor:valprobe-ghp_a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R8", "expected": "Cursor:valprobe-<redacted>"},
    {"name": "discovery source path with a token", "field": "source_path", "input": "~/.cursor/mcp.json#valprobe-ghp_a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R8", "expected": "~/.cursor/mcp.json#valprobe-<redacted>"},
    {"name": "discovery slug without a token", "field": "slug", "input": "Cursor:jira", "expected": "Cursor:jira"},
    {"name": "a run longer than any name is redacted whole", "field": "server_key", "input": "", "expected": "<redacted>"}
  ]
}
