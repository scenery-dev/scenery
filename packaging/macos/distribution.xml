<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Scenery</title>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <allowed-os-versions>
        <os-version min="12.0"/>
    </allowed-os-versions>
    <domains enable_localSystem="true"/>
    <choices-outline>
        <line choice="runner"/>
    </choices-outline>
    <choice id="runner" visible="false" title="Scenery" start_selected="true">
        <pkg-ref id="dev.scenery.runner"/>
    </choice>
    <pkg-ref id="dev.scenery.runner" version="@VERSION@" onConclusion="none">scenery-component.pkg</pkg-ref>
</installer-gui-script>
